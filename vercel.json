{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/html/index.html",
      "destination": "https://elenestresort.com/",
      "permanent": true
    },
    {
      "source": "/html",
      "destination": "https://elenestresort.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://elenestresort.com/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "https://elenestresort.com/",
      "permanent": true
    },
    {
      "source": "/html/:file((?!reset-password).+).html",
      "destination": "https://elenestresort.com/:file",
      "permanent": true
    },
    {
      "source": "/:file((?!reset-password).+).html",
      "destination": "https://elenestresort.com/:file",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/reset-password.html",
      "destination": "/html/reset-password.html"
    },
    {
      "source": "/html/reset-password",
      "destination": "/html/reset-password.html"
    },
    {
      "source": "/html/reset-password/",
      "destination": "/html/reset-password.html"
    },
    {
      "source": "/",
      "destination": "/html/index.html"
    },
    {
      "source": "/:file",
      "destination": "/html/:file.html"
    }
  ]
}
