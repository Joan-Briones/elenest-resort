{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/html/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/html/index.html"
    }
  ]
}
